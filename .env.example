# Copy to .env and fill in. Never commit .env.

# --- LLM provider (swappable): gemini | vertex ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_SMALL=gemini-2.5-flash-lite
GEMINI_MODEL_LARGE=gemini-2.5-pro
# Only for LLM_PROVIDER=vertex
GCP_PROJECT=
GCP_LOCATION=us-central1

# --- Database (DuckDB file; Postgres/Docker returns in a later phase) ---
DUCKDB_PATH=data/disputedesk.duckdb

# --- Guardrails ---
PER_CASE_BUDGET_USD=0.05
KILL_SWITCH=false

# --- Observability (Langfuse free tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
